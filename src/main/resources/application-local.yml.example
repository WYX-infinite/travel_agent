travel:
  ai:
    base-url: https://dashscope.aliyuncs.com/compatible-mode/v1
    chat-model: qwen-plus
    embedding-model: text-embedding-v3
  local-secrets:
    dashscope-api-key: replace-with-your-local-key
    amap-web-api-key: replace-with-your-local-key
    # Base64 text whose decoded value contains at least 32 random bytes.
    jwt-secret: replace-with-your-base64-encoded-random-secret
    db-username: root
    db-password: replace-with-your-local-password
